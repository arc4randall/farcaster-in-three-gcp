# Edit these, or override any of them in your shell before running the scripts.
: "${PROJECT:=$(gcloud config get-value project 2>/dev/null)}"
: "${ZONE:=us-central1-a}"
: "${VM:=fc-node}"
: "${MACHINE:=e2-standard-4}"      # 4 vCPU, 16 GB RAM: Snapchain's documented minimum
: "${DISK_GB:=2000}"               # docs ask for 2 TB free; the snapshot alone is several hundred GB
: "${SNAPCHAIN_VERSION:=0.14.3}"   # image tag AND git tag v$SNAPCHAIN_VERSION for the compose file
